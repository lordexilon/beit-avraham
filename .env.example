# Variables de Entorno - Beit Avraham (Raíz / Scripts SCA)
# Copia este archivo como .env para desarrollo local o configura en el proveedor de Cloud.

# Conexión Supabase (para logging SCA y persistencia)
SCA_SUPABASE_URL=https://tu-proyecto.supabase.co
SCA_SUPABASE_ANON_KEY=tu_clave_anon_supabase

# Token de Administración local para gestión de contenidos
CONTENT_ADMIN_TOKEN=token_seguro_admin_local

# API Key de xAI (Grok) para la Javrutá IA interactiva
XAI_API_KEY=xai-tu-api-key-aqui
